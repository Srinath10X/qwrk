{
  "name": "qwrk",
  "version": "0.3.0",
  "description": "A minimalistic web framework, fast enough for your ideas.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && tsc -p test && vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Srinath10X/qwrk.git"
  },
  "keywords": [],
  "author": "Srinath10X",
  "license": "MIT",
  "type": "module",
  "types": "dist/index.d.ts",
  "bugs": {
    "url": "https://github.com/Srinath10X/qwrk/issues"
  },
  "homepage": "https://github.com/Srinath10X/qwrk#readme",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "imports": {
    "#qwrk/*": "./dist/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx/runtime.d.ts",
      "default": "./dist/jsx/runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx/runtime.d.ts",
      "default": "./dist/jsx/runtime.js"
    }
  }
}
